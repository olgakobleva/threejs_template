{
    "name": "ledgerly",
    "version": "0.1.0",
    "private": true,
    "description": "English-language bookkeeping app for Dutch sole traders (ZZP / eenmanszaak): invoices, receipts, BTW returns and income-tax estimates.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
    },
    "license": "ISC",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.72.0",
        "idb": "^8.0.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "prettier": "3.0.2",
        "typescript": "^5.7.3",
        "vite": "^5.4.11"
    }
}
